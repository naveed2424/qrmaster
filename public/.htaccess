# hosting.com (Apache / LiteSpeed) Static Web Hosting Configuration for 2qrcode.com
DirectoryIndex index.html index.htm
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always serve critical static, AdSense & SEO root files directly
  RewriteRule ^(ads\.txt|robots\.txt|sitemap\.xml|favicon\.ico|favicon\.svg|video\.html)$ - [L]

  # Serve existing static files, CSS, JS, images, audio & video directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Avoid rewriting already-targeted index.html
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]

  # Route all other SPA page paths cleanly to React index.html with HTTP 200
  RewriteRule ^ index.html [L]
</IfModule>

# Standard MIME Types for Vite ES Modules, Icons, SVG & Media
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/x-icon .ico
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType audio/mpeg .mp3
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Security & AdSense-Compatible Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Keep HTML entrypoints and AdSense/SEO files fresh
  <FilesMatch "^(index\.html|video\.html|ads\.txt|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Long cache for content-hashed JS/CSS/Image bundles
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable Gzip Compression when available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
