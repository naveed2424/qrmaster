# hosting.com (Apache / LiteSpeed) Static Web Hosting Configuration for 2qrcode.com
DirectoryIndex index.html index.htm
Options -MultiViews -Indexes
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce canonical HTTPS + non-www host (proxy & Cloudflare compatible)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} ^(www\.)?2qrcode\.com$ [NC]
  RewriteRule ^(.*)$ https://2qrcode.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.2qrcode\.com$ [NC]
  RewriteRule ^(.*)$ https://2qrcode.com/$1 [R=301,L]

  # Canonicalize external /index.html requests to / (preserves query strings like ?tool= or ?view=)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://2qrcode.com/ [R=301,L]

  # 301 Redirect clean vanity paths to canonical query routes
  RewriteRule ^blog/?$ https://2qrcode.com/?view=blog [R=301,L,NC,QSA]
  RewriteRule ^batch/?$ https://2qrcode.com/?view=batch [R=301,L,NC,QSA]
  RewriteRule ^customizer/?$ https://2qrcode.com/?view=customizer [R=301,L,NC,QSA]
  RewriteRule ^converter/?$ https://2qrcode.com/?view=converter [R=301,L,NC,QSA]
  RewriteRule ^about/?$ https://2qrcode.com/?view=about [R=301,L,NC,QSA]
  RewriteRule ^faqs?/?$ https://2qrcode.com/?view=faqs [R=301,L,NC,QSA]
  RewriteRule ^reviews/?$ https://2qrcode.com/?view=reviews [R=301,L,NC,QSA]
  RewriteRule ^contact/?$ https://2qrcode.com/?view=contact [R=301,L,NC,QSA]
  RewriteRule ^privacy(-policy)?/?$ https://2qrcode.com/?view=privacy [R=301,L,NC,QSA]
  RewriteRule ^cookies(-policy)?/?$ https://2qrcode.com/?view=cookies [R=301,L,NC,QSA]
  RewriteRule ^terms(-of-service)?/?$ https://2qrcode.com/?view=terms [R=301,L,NC,QSA]
  RewriteRule ^video/?$ https://2qrcode.com/?view=video [R=301,L,NC,QSA]

  # Always serve critical static, AdSense & SEO root files directly
  RewriteRule ^(ads\.txt|robots\.txt|sitemap\.xml|favicon\.ico|favicon\.svg|video\.html)$ - [L]

  # Serve root / cleanly via DirectoryIndex
  RewriteRule ^$ index.html [L]

  # Serve existing static files, CSS, JS, images, audio & video directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Return real HTTP 404 (via ErrorDocument 404 /index.html) for nonexistent paths instead of 200 OK
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ - [R=404,L]
</IfModule>

# Standard MIME Types for Vite ES Modules, Icons, SVG & Media
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/x-icon .ico
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType audio/mpeg .mp3
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Security & AdSense-Compatible Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Keep HTML entrypoints and AdSense/SEO files fresh
  <FilesMatch "^(index\.html|video\.html|ads\.txt|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Long cache for content-hashed JS/CSS/Image bundles
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable Gzip Compression when available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
