# hosting.com (Apache / LiteSpeed) Static Web Hosting Configuration for 2qrcode.com
DirectoryIndex index.html index.htm
Options -MultiViews -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always serve critical static, AdSense & SEO root files directly first
  RewriteRule ^(ads\.txt|robots\.txt|sitemap\.xml|llms\.txt|favicon\.ico|favicon\.svg|video\.html|404\.html)$ - [L]

  # Canonicalize www subdomain to apex https://2qrcode.com cleanly (no HTTP/HTTPS proxy loop)
  RewriteCond %{HTTP_HOST} ^www\.2qrcode\.com$ [NC]
  RewriteRule ^(.*)$ https://2qrcode.com/$1 [R=301,L]

  # Canonicalize external /index.html requests to / (preserves query strings like ?tool= or ?view=)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}[[:space:]]/+index\.html([[:space:]]|\?) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 301 Redirect clean vanity paths to canonical query routes
  RewriteRule ^blog/?$ /?view=blog [R=301,L,NC,QSA]
  RewriteRule ^batch/?$ /?view=batch [R=301,L,NC,QSA]
  RewriteRule ^customizer/?$ /?view=customizer [R=301,L,NC,QSA]
  RewriteRule ^converter/?$ /?view=converter [R=301,L,NC,QSA]
  RewriteRule ^about/?$ /?view=about [R=301,L,NC,QSA]
  RewriteRule ^faqs?/?$ /?view=faqs [R=301,L,NC,QSA]
  RewriteRule ^reviews/?$ /?view=reviews [R=301,L,NC,QSA]
  RewriteRule ^contact/?$ /?view=contact [R=301,L,NC,QSA]
  RewriteRule ^privacy(-policy)?/?$ /?view=privacy [R=301,L,NC,QSA]
  RewriteRule ^cookies(-policy)?/?$ /?view=cookies [R=301,L,NC,QSA]
  RewriteRule ^terms(-of-service)?/?$ /?view=terms [R=301,L,NC,QSA]
  RewriteRule ^video/?$ /?view=video [R=301,L,NC,QSA]

  # Serve existing static files, CSS, JS, images, audio, video & root directory (/) directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Return real HTTP 404 via /404.html for nonexistent paths (guarded against internal error subrequests)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
  RewriteRule ^ - [R=404,L]
</IfModule>

# Standard MIME Types for Vite ES Modules, Icons, SVG & Media
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/x-icon .ico
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType audio/mpeg .mp3
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Security & AdSense-Compatible Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Keep HTML entrypoints and AdSense/SEO files fresh
  <FilesMatch "^(index\.html|video\.html|404\.html|ads\.txt|robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Long cache for content-hashed JS/CSS/Image bundles
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable Gzip Compression when available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
